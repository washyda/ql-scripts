{
  "name": "qinglong-ts-scripts",
  "version": "1.0.0",
  "private": true,
  "description": "A maintainable TypeScript starter for QingLong script repositories.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm test",
    "dev:hello": "tsx scripts/hello_world.ts",
    "dev:natfrp": "tsx scripts/natfrp_daily_checkin.ts",
    "dev:cloudgame": "tsx scripts/cloudgame_genshin_checkin.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "axios": "^1.11.0",
    "moment": "^2.30.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
